# ============================================================
# OpenSpider 部署配置
# ============================================================

# ============================================================
# Docker 镜像（内网镜像仓库）
# ============================================================

# Python 基础镜像
BASE_IMAGE=python:3.13-slim

# Nginx 前端镜像
NGINX_IMAGE=nginx:alpine

# ============================================================
# PyPI 源（内网 PyPI 仓库）
# ============================================================

PIP_INDEX_URL=https://pypi.org/simple
# 内网示例: PIP_INDEX_URL=http://pypi.internal.com/simple
# 如果 HTTPS 证书问题: PIP_TRUSTED_HOST=pypi.internal.com
PIP_TRUSTED_HOST=

# ============================================================
# 端口映射
# ============================================================

BACKEND_PORT=10010
FRONTEND_PORT=10009

# ============================================================
# 数据库配置
# ============================================================

# 数据库类型: sqlite 或 mysql
DB_TYPE=mysql

# SQLite 配置（DB_TYPE=sqlite 时生效）
SQLITE_PATH=./data/openspider.db

# MySQL 配置（DB_TYPE=mysql 时生效）
# 容器内用 host.docker.internal 访问宿主机 MySQL
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=openspider

# ============================================================
# 服务配置
# ============================================================

API_HOST=0.0.0.0
API_PORT=8088

# ============================================================
# JWT 认证（必填，生产环境请替换为随机 64 字符字符串）
# ============================================================

JWT_SECRET_KEY=change-me-in-production-use-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ============================================================
# 日志配置
# ============================================================

LOG_LEVEL=INFO
LOG_FILE=./logs/openspider.log
